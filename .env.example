# Kalshi API credentials (only needed for live trading)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Safety: paper trading is ON by default. Set to "false" only when ready to trade real money.
PAPER_TRADING=true
PAPER_BANKROLL_CENTS=100000

# Risk limits (cents unless noted)
MAX_ORDER_COST_CENTS=2000
MAX_POSITION_CONTRACTS=100
MAX_OPEN_EXPOSURE_CENTS=10000
MAX_DAILY_LOSS_CENTS=5000
KELLY_FRACTION=0.25
MIN_EDGE=0.02
MAX_MARKETS=5
POLL_SECONDS=30

# Comma-separated Kalshi series tickers to scan (liquid series recommended)
SCAN_SERIES=KXBTCD,KXETHD,KXHIGHNY,KXHIGHCHI,KXMLBGAME,KXNBA,KXNFLGAME

# Optional LLM advisor (any OpenAI-compatible API). Leave blank for quant ranking.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Where trade history (win rate / P&L tracking) is persisted
TRADE_HISTORY_PATH=trade_history.json
